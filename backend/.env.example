# ─────────────────────────────────────────────────────────────
#  BACKEND ENVIRONMENT VARIABLES
#  Rename this file from ".env.example" to ".env"
#  and fill in your real values below.
#  NEVER share this file or push it to GitHub (it has secrets).
# ─────────────────────────────────────────────────────────────

# Your Google Gemini API key (get it free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=paste_your_gemini_key_here

# Your MongoDB connection string (from MongoDB Atlas - free tier)
# Example: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/interviewbot
MONGODB_URI=paste_your_mongodb_connection_string_here

# The port your backend server runs on (leave as 5000)
PORT=5000
